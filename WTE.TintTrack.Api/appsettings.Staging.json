{
  "ConnectionStrings": {
    "TintTrackCRMMasterConnection": "Server=STAGING_SQL_SERVER;Database=WTE.TintTrackCRM.Master-STAGING;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "TintTrackCRMTenantConnection": "Server=STAGING_SQL_SERVER;Database=WTE.TintTrackCRM.DefaultClient-STAGING;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "ApplicationSettings": {
    "TenantConnStrTemplate": "Server=STAGING_SQL_SERVER;Database=WTE.TintTrackCRM.{TENANTCODE}-STAGING;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "AccessTokenExpiryAgeInMinutes": 30,
    "RefreshTokenExpiryAgeInDays": 7,
    "EnableSwaggerInProd": true
  },

  "Jwt": {
    "Issuer": "https://your-staging-backend-domain.com",
    "TokenExpirationMinutes": 30,
    "RequireHttpsMetadata": true
  },

  "IdentityServer": {
    "Authority": "https://your-staging-backend-domain.com",
    "RequireHttpsMetadata": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://your-staging-frontend-domain.com"
    ]
  }
}

